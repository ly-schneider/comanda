# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
LOG_LEVEL=info

# Backend API URL (client-side requests)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Backend URL (server-side requests, can use Docker network name)
BACKEND_INTERNAL_URL=http://backend:8080

# Shared secret for internal server-to-backend calls (e.g. trusted-origins feed).
# Generate with: openssl rand -hex 32
# Must match INTERNAL_API_TOKEN on the backend side.
INTERNAL_API_TOKEN=

# =============================================================================
# BETTER AUTH
# =============================================================================
# App URL (used by Better Auth for callbacks and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for signing sessions/tokens (min 32 characters, generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-random-secret-min-32-chars-here
BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Better Auth needs direct database access for sessions/users, and reads across
# tenants when binding the active org — so it uses the privileged role.
DATABASE_URL=postgresql://comanda_privileged:comanda_privileged@localhost:5432/comanda

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================
# Google OAuth (register callback: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# POS CONFIGURATION
# =============================================================================
NEXT_PUBLIC_POS_PIN=0000
NEXT_PUBLIC_POS_IDLE_TIMEOUT=300000

# =============================================================================
# SENTRY (Optional — disabled when DSN is absent)
# =============================================================================
# NEXT_PUBLIC_SENTRY_DSN=
