set dotenv-filename := ".env.local"

BIN := justfile_directory() / "bin"

# Default
default:
    @just --list

# ── Private ──

[private]
_go-tool bin pkg:
    #!/usr/bin/env bash
    [[ -x "{{BIN}}/{{bin}}" ]] && exit 0
    mkdir -p "{{BIN}}" && GOBIN="{{BIN}}" go install "{{pkg}}"

# ── Setup ──

# Install all dev tools
[group('setup')]
tools: (_go-tool "golangci-lint" "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.5.0") (_go-tool "swag" "github.com/swaggo/swag/cmd/swag@v1.16.6") (_go-tool "air" "github.com/air-verse/air@v1.63.0")
    @# Install Atlas CLI if not present
    @command -v atlas >/dev/null 2>&1 || (echo "Installing Atlas CLI..." && curl -sSf https://atlasgo.sh | sh)

# ── Dev ──

# Start API server with live-reload
[group('dev')]
dev: (_go-tool "air" "github.com/air-verse/air@v1.63.0")
    "{{BIN}}/air" -c .air.toml

# Start services (pass --profile dev for pgAdmin)
[group('dev')]
up *args:
    docker compose up -d {{args}}

# Stop services (pass --volumes for DATA LOSS)
[group('dev')]
down *args:
    docker compose --profile dev down --remove-orphans {{args}}

# Clean build artifacts
[group('dev')]
clean:
    rm -rf tmp/ build-errors.log docs/

# ── Lint ──

# Run linters (pass --fix to auto-fix)
[group('lint')]
lint *args: (_go-tool "golangci-lint" "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.5.0")
    GOTOOLCHAIN=auto GOWORK=off "{{BIN}}/golangci-lint" run {{args}} --timeout=3m --max-issues-per-linter=0 --max-same-issues=0 ./...

# Format code
[group('lint')]
fmt:
    go fmt ./...

# Tidy go.mod
[group('lint')]
tidy:
    GOWORK=off go mod tidy

# Verify go.mod is tidy (CI)
[group('lint')]
tidy-check: tidy
    git diff --exit-code -- go.mod go.sum

# ── Generate ──

# Run all code generators
[group('generate')]
generate: generate-ent generate-api

# Generate Ent ORM code
[group('generate')]
generate-ent:
    mkdir -p ./internal/generated/ent
    echo "package ent" > ./internal/generated/ent/ent.go
    go tool ent generate --feature sql/modifier --feature sql/upsert --feature intercept --feature privacy --target ./internal/generated/ent ./internal/schema

# Generate API types from OpenAPI
[group('generate')]
generate-api:
    npx @redocly/cli bundle openapi/openapi.yaml -o openapi/bundled.yaml
    oapi-codegen -config oapi-codegen.yaml openapi/bundled.yaml

# Generate Swagger docs
[group('generate')]
swag: (_go-tool "swag" "github.com/swaggo/swag/cmd/swag@v1.16.6")
    "{{BIN}}/swag" init -g cmd/backend/main.go --parseInternal --parseDependency --generatedTime=false

# ── Test ──

# Run unit tests (override path: just test ./...)
[group('test')]
test *args='./internal/...':
    go test -v -race {{args}}

# Run integration tests. Needs POSTGRES_TEST_DSN (privileged); RLS tests
# additionally need POSTGRES_TEST_DSN_APP (the comanda_app role). Run
# `just bootstrap-rls` against the test DB once so the app role + RLS exist.
[doc('Run integration tests (needs a provisioned test DB)')]
[group('test')]
test-integration:
    go test -v -race -count=1 -timeout=5m ./test/integration/...

# ── Database ──

# Apply pending Atlas migrations
[group('db')]
migrate *args:
    atlas migrate apply --dir "file://db/migrations" --url "$DATABASE_URL" {{args}}

# Run by the DB owner/superuser BEFORE the first migration, so migrations create
# their tables under the right owner. Idempotent — re-run after migrations to
# repair ownership or grant drift. Local dev gets this automatically via `just up`.
[doc('Bootstrap the two RLS roles (comanda_privileged owner + comanda_app)')]
[group('db')]
bootstrap-rls:
    psql "$DATABASE_URL" -f db/provisioning/bootstrap-rls-roles.sql

# There is intentionally no HTTP path to set is_platform_admin (it would be a
# privilege-escalation vector); Leys provisions platform admins out of band.
[doc('Grant platform-admin to a Leys operator by email')]
[group('db')]
grant-platform-admin email:
    psql "$DATABASE_URL" -c "UPDATE \"user\" SET is_platform_admin = true WHERE email = '{{email}}'"

# Same shape platform-admin provisioning produces: organization, settings, and a
# verified primary domain (default <slug>.localhost, which browsers resolve to
# 127.0.0.1). Args are positional: just create-tenant blessthun 'BlessThun'
[doc('Create a tenant with its org, settings and primary host')]
[group('db')]
create-tenant slug name host='':
    psql "$DATABASE_URL" -v ON_ERROR_STOP=1 \
      -v tenant_slug={{slug}} -v tenant_name='{{name}}' \
      -v tenant_host='{{ if host == "" { slug + ".localhost" } else { host } }}' \
      -f db/seed/00_tenant.sql

# Creates the user if it doesn't exist yet. Sign in afterwards via OTP (Mailpit on
# http://localhost:8025) — there is no password to set. Args are positional:
# just bootstrap-admin you@example.com 'Your Name' blessthun
[doc("Make an email a platform admin and owner of a tenant's organization")]
[group('db')]
bootstrap-admin email name='Local Admin' slug='default':
    psql "$DATABASE_URL" -v ON_ERROR_STOP=1 \
      -v admin_email={{email}} -v admin_name='{{name}}' -v seed_slug={{slug}} \
      -f db/seed/00_platform_admin.sql

# Migrations, demo catalog, and a platform-admin owner of the seed tenant.
# Branding and plugins stay unseeded (db/seed/05_settings.sql applies the dev
# set). Safe to re-run.
[doc('Full local environment from an empty DB')]
[group('db')]
bootstrap-local email name='Local Admin' slug='default':
    #!/usr/bin/env bash
    set -euo pipefail
    just migrate
    just seed {{slug}}
    just bootstrap-admin {{email}} '{{name}}' {{slug}}
    echo "→ sign in at http://localhost:3000/login as {{email}} (OTP inbox: http://localhost:8025)"

# Generate a new migration from Ent schema diff
[group('db')]
migrate-diff name:
    atlas migrate diff {{name}} --env local

# Validate migration files and compute checksum
[group('db')]
migrate-hash:
    atlas migrate hash --dir "file://db/migrations"

# Show migration status
[group('db')]
migrate-status:
    atlas migrate status --dir "file://db/migrations" --url "$DATABASE_URL"

# Lint migrations for common issues
[group('db')]
migrate-lint:
    atlas migrate lint --env local --latest 1

# Drop all objects (DATA LOSS)
[confirm("⚠️  This will DROP ALL OBJECTS. Continue?")]
[group('db')]
migrate-clean:
    atlas schema clean --url "$DATABASE_URL"

# Seed the demo catalog into a tenant by slug (default 'default'). Re-points the
# shared demo set, so one tenant holds it at a time. Branding, plugins and the
# ops demo (05_settings, 99_ops_demo) are not seeded — those are per-tenant setup.
[doc('Seed the demo catalog into a tenant by slug')]
[group('db')]
seed slug='default':
    #!/usr/bin/env bash
    set -euo pipefail
    tid=$(psql "$DATABASE_URL" -tAc "SELECT id FROM tenant WHERE slug = '{{slug}}'")
    if [ -z "$tid" ]; then echo "no tenant with slug '{{slug}}'"; exit 1; fi
    echo "seeding catalog into '{{slug}}' ($tid)"
    for f in db/seed/01_categories.sql db/seed/02_jetons.sql db/seed/03_products.sql db/seed/04_bundles.sql db/seed/06_inventory.sql; do
      echo "  $f..."; psql "$DATABASE_URL" -v seed_tenant="$tid" -f "$f"
    done

# ── Load test ──

# Seed loadtest users, sessions, and POS/station devices into the load-test
# tenant (resolved from its verified host). Runs against a PRIVILEGED $DATABASE_URL.
# Override the tenant with target_host=<host>.
[doc('Seed loadtest users, sessions and devices into the load-test tenant')]
[group('loadtest')]
loadtest-seed target_host='load-test.staging.comanda.leys.ch':
    psql "$DATABASE_URL" -v target_host={{target_host}} -f loadtest/seed.sql

# Bump inventory for the load-test tenant's simple products so a run can't
# deplete stock. Re-run any time stock is low; each run adds +50k per product.
[doc("Bump inventory for the load-test tenant's simple products")]
[group('loadtest')]
loadtest-stock target_host='load-test.staging.comanda.leys.ch':
    psql "$DATABASE_URL" -v target_host={{target_host}} -f loadtest/stock.sql

# Remove all loadtest data (and generated orders) from the load-test tenant.
[group('loadtest')]
loadtest-cleanup target_host='load-test.staging.comanda.leys.ch':
    psql "$DATABASE_URL" -v target_host={{target_host}} -f loadtest/cleanup.sql

# Run the API load test. BASE_URL defaults to the load-test tenant.
# Usage: just loadtest [smoke|baseline|stress]
[doc('Run the API load test')]
[group('loadtest')]
loadtest profile='smoke':
    #!/usr/bin/env bash
    set -e
    k6 run ${BASE_URL:+-e BASE_URL="$BASE_URL"} -e PROFILE="{{profile}}" loadtest/k6.js

# Run the browser load test. WEB_URL defaults to the load-test tenant.
# Usage: just loadtest-browser [smoke|baseline|stress]
[doc('Run the browser load test')]
[group('loadtest')]
loadtest-browser profile='smoke':
    #!/usr/bin/env bash
    set -e
    k6 run ${WEB_URL:+-e WEB_URL="$WEB_URL"} -e PROFILE="{{profile}}" loadtest/browser.js

# Run API + browser load tests in parallel (both default to the load-test tenant).
# Output goes to loadtest/results/{api,browser}-<timestamp>.json for later diffing.
# Usage: just loadtest-full [smoke|baseline|stress]
[doc('Run API + browser load tests in parallel')]
[group('loadtest')]
loadtest-full profile='baseline':
    #!/usr/bin/env bash
    set -e
    PROFILE="{{profile}}"
    TS=$(date +%Y%m%d-%H%M%S)
    mkdir -p loadtest/results
    echo "▶ Starting API load (BASE_URL=${BASE_URL:-<load-test default>}, PROFILE=$PROFILE)..."
    k6 run \
      ${BASE_URL:+-e BASE_URL="$BASE_URL"} -e PROFILE="$PROFILE" \
      --summary-export "loadtest/results/api-$TS.json" \
      loadtest/k6.js &
    API_PID=$!
    echo "▶ Starting browser load (WEB_URL=${WEB_URL:-<load-test default>}, PROFILE=$PROFILE)..."
    k6 run \
      ${WEB_URL:+-e WEB_URL="$WEB_URL"} -e PROFILE="$PROFILE" \
      --summary-export "loadtest/results/browser-$TS.json" \
      loadtest/browser.js &
    BROWSER_PID=$!
    API_STATUS=0; BROWSER_STATUS=0
    wait $API_PID || API_STATUS=$?
    wait $BROWSER_PID || BROWSER_STATUS=$?
    echo "API exit=$API_STATUS, browser exit=$BROWSER_STATUS"
    echo "Results: loadtest/results/api-$TS.json  loadtest/results/browser-$TS.json"
    exit $(( API_STATUS | BROWSER_STATUS ))
