# .env.example
# Copy to `.env` and fill in real values. This file holds BOTH config & secrets.

# Privileged DB connection (table owner; runs migrations, cron, tenant
# resolution; bypasses RLS via ownership).
DATABASE_URL=postgres://comanda_privileged:postgres@localhost:5432/comanda?sslmode=disable
# RLS-bound app connection for request traffic. The per-request tenant tx sets
# app.tenant_id; policies filter on it. Falls back to DATABASE_URL if unset
# (single-DSN dev only — no role separation).
DATABASE_URL_APP=postgres://comanda_app:postgres@localhost:5432/comanda?sslmode=disable
# Direct-to-Postgres connection for the LISTEN/NOTIFY inventory listener, which a
# transaction-mode pooler (PgBouncer) can't serve. Falls back to DATABASE_URL_APP
# then DATABASE_URL. Only set in deployments where the app DSNs point at PgBouncer.
# DATABASE_URL_LISTEN=postgres://comanda_app:postgres@localhost:5432/comanda?sslmode=disable
# Path to the Postgres server CA (PEM). Required with sslmode=verify-full against
# a managed PG that uses a private CA (e.g. Scaleway's per-instance self-signed
# CA), since the DSN carries no sslrootcert. Pinned onto both pools' TLS config.
# Leave unset for local dev (sslmode=disable).
# DATABASE_CA_PATH=/etc/ssl/scaleway/ca.crt
# Dev fallback for the host-based tenant resolver (P2): slug of the tenant a
# request resolves to when its Host matches no tenant_domain row and is not a
# platform host. MUST be unset in production — otherwise an unknown-host request
# that should 404 silently resolves to this tenant.
BOOTSTRAP_TENANT_SLUG=default
# Comma-separated hostnames that resolve to the no-tenant platform context
# (platform admins operate cross-tenant here). Leave empty in dev (the seeded
# `localhost` tenant_domain → bootstrap tenant). Prod: your admin host(s), e.g.
# admin.comanda.leys.ch. A host cannot be both a tenant_domain and a platform host.
# PLATFORM_HOSTS=
# Internal/test only: when true, the X-Tenant-Id header is honored as a tenant
# override. MUST stay false (unset) in production — the web proxy strips the
# header, and host-based resolution is the only trusted production path.
# TENANT_HEADER_TRUSTED=false
# Local-dev-only escape hatch: when DATABASE_URL_APP is unset, allow the app
# pool to fall back to DATABASE_URL. NEVER set this in any shared/remote env —
# it routes request traffic through the privileged role and disables RLS.
# ALLOW_SINGLE_DSN=true

# Docker PostgreSQL settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=comanda
POSTGRES_PORT=5432

BETTER_AUTH_URL=http://localhost:3000

# Master key for encrypting per-tenant payment/email secrets at rest (AES-256-GCM).
# Base64-encoded 32 bytes. Generate: `openssl rand -base64 32`. In prod this comes
# from Doppler. When unset, the encryptor is disabled and configuring per-tenant
# Payrexx/Plunk credentials fails.
PAYMENTS_MASTER_KEY=

# Payrexx (P4): per-tenant credentials are now stored encrypted on each tenant's
# settings row via the admin API. These globals are an OPTIONAL first-boot seed —
# when set, they auto-populate the bootstrap tenant's encrypted creds on startup
# (idempotent, no-op when unset). Leave unset for pure BYO-per-tenant.
# Payrexx instance name (your-instance.payrexx.com)
PAYREXX_INSTANCE=your-instance
# Payrexx API secret for request signing (found in Payrexx dashboard)
PAYREXX_API_SECRET=your_api_secret_here
# Payrexx webhook secret for verifying incoming webhooks
PAYREXX_WEBHOOK_SECRET=your_webhook_secret_here

APP_ENV=dev
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:3000 # Frontend base URL for redirects

LOG_LEVEL=info
LOG_DEVELOPMENT=true

SECURITY_ENABLE_HSTS=false # true for HTTPS connections
SECURITY_ENABLE_CSP=true
SECURITY_TRUSTED_ORIGINS=http://localhost:3000

# Sentry (Optional — disabled when DSN is absent)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=dev

# Object storage (S3-compatible). MinIO defaults for local development; in
# staging/prod these come from Doppler (Scaleway Object Storage). Leave the keys
# blank to disable image uploads.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=comanda-assets
STORAGE_PUBLIC_URL=http://localhost:9000/comanda-assets

# Plunk (P4): per-tenant credentials live encrypted on the settings row; a tenant
# without its own creds falls back to these platform globals. Also seeded onto the
# bootstrap tenant on first boot when set (idempotent).
# Plunk API key for sending transactional emails
PLUNK_API_KEY=

# Optional: customize sender info (defaults shown)
# PLUNK_FROM_NAME=Comanda
# PLUNK_FROM_EMAIL=noreply@leys.ch
# PLUNK_REPLY_TO=support@leys.ch

# Elvanto API
ELVANTO_API_KEY=

# Android update check (defaults to ly-schneider/comanda)
# ANDROID_GITHUB_REPO=ly-schneider/comanda

# ── Custom domains (BYO) ──
# Platform apex. Hostnames at or under it are platform subdomains and are
# rejected as custom domains (those are provisioned, not brought). Empty = no
# such restriction (dev).
# CUSTOM_DOMAIN_BASE=comanda.leys.ch
# CNAME target tenants point their custom domain at; also the host the ownership
# check requires the domain's CNAME to resolve to. When empty the background DNS
# verifier is disabled, so local runs don't spin.
# CUSTOM_DOMAIN_CNAME_TARGET=ingress.comanda.leys.ch
# How often the verifier re-checks DNS for unverified domains (Go duration).
# CUSTOM_DOMAIN_VERIFY_INTERVAL=60s
# Shared secret gating GET /internal/trusted-origins (the cross-tenant feed of
# verified custom-domain hostnames the web tier loads into Better Auth's
# trustedOrigins). Sent as `Authorization: Bearer <token>`. When empty the feed
# route is NOT registered at all (fail closed). Provision via Doppler.
# INTERNAL_API_TOKEN=

# ── Ingress reconciler (Kubernetes; provisions TLS for verified domains) ──
# Disabled by default; enabled only in-cluster.
# INGRESS_RECONCILER_ENABLED=false
# Namespace the reconciler manages (and is scoped to — never cluster-wide).
# INGRESS_NAMESPACE=comanda
# INGRESS_CLASS_NAME=traefik
# cert-manager ClusterIssuer for genuine third-party (BYO) domains, solved over HTTP-01.
# INGRESS_HTTP01_ISSUER=letsencrypt-http01
# ClusterIssuer for hostnames in INGRESS_MANAGED_ZONE, solved over DNS-01 (works behind
# a Cloudflare proxy, where HTTP-01 cannot). Required when INGRESS_MANAGED_ZONE is set.
# INGRESS_DNS01_ISSUER=letsencrypt-cf-dns01
# Apex DNS zone our cert-manager Cloudflare token controls. Verified domains at or under
# it issue via DNS-01; everything else uses HTTP-01. (Single-label subdomains of
# CUSTOM_DOMAIN_BASE are served by the platform wildcard, so they get no per-domain cert.)
# INGRESS_MANAGED_ZONE=comanda.leys.ch
# Backend Service the generated Ingresses route custom domains to.
# INGRESS_WEB_SERVICE=comanda-web
# INGRESS_WEB_SERVICE_PORT=80
# How often the reconciler syncs Ingress/Certificate objects (Go duration).
# INGRESS_RECONCILE_INTERVAL=60s
# Per-pass timeout bounding a single reconcile sync (Go duration).
# INGRESS_RECONCILE_TIMEOUT=30s
# Dev-only: path to a kubeconfig. In-cluster uses the ServiceAccount token.
# KUBECONFIG=
